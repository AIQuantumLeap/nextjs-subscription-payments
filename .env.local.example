NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from: https://app.supabase.com/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Required for AI image descriptions (Pro/Enterprise plan feature)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# ── OAuth Providers (configure in Supabase Dashboard > Auth > Providers) ──────
# Google: https://console.cloud.google.com/apis/credentials
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_REDIRECT_URI="http://localhost:3000/auth/callback"

# GitHub: https://github.com/settings/developers
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=""
SUPABASE_AUTH_EXTERNAL_GITHUB_REDIRECT_URI="http://localhost:3000/auth/callback"

# Apple: https://developer.apple.com/account/resources/identifiers/list/serviceId
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=""
